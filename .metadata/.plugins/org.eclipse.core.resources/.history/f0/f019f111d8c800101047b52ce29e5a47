package com.cmc.repaso.entidades;

public class Item {
	private String nombre;
	private int productosActuales;
	private int productosDevueltos;
	private int productosVendidos;
	
	
	//metodo getter y setter
	public String getNombre() {
		return nombre;
	}

	public void setNombre(String nombre) {
		this.nombre = nombre;
	}

	public int getProductosActuales() {
		return productosActuales;
	}

	public void setProductosActuales(int productosActuales) {
		this.productosActuales = productosActuales;
	}

	public int getProductosDevueltos() {
		return productosDevueltos;
	}

	public void setProductosDevueltos(int productosDevueltos) {
		this.productosDevueltos = productosDevueltos;
	}

	public int getProductosVendidos() {
		return productosVendidos;
	}

	public void setProductosVendidos(int productosVendidos) {
		this.productosVendidos = productosVendidos;
	}
	
	//metodos vender y devolver

	public void vender(int cantidad) {
	        this.productosActuales -= cantidad;       // Disminuye productos actuales
	        this.productosVendidos += cantidad;       // Incrementa productos vendidos
	        System.out.println("Venta realizada: " + cantidad + " unidades de " + this.nombre);
	    }
	public void devolver(int cantidad) {
		this.productosActuales += cantidad; //incrementa productos actuales
		this.productosVendidos -= cantidad; //disminuye productos vendiddos
		this.productosDevueltos += cantidad; //incrementa productos devueltos
		 System.out.println("Devolución realizada: " + cantidad + " unidades de " + this.nombre);
	}
	
	//imprimir datos
	public void imprimir() {

		System.out.println("=================Informacion del Producto=============");
		System.out.println("Nombre del Producto: " + getNombre());
		System.out.println("Productos actuales: " + getProductosActuales());
		System.out.println("Productos Devueltos: " + getProductosDevueltos());
		System.out.println("Productos Vendidos: " + getProductosVendidos());
	}
	}

