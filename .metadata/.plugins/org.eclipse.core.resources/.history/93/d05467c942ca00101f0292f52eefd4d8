package com.cmc.directorio.test;
import com.cmc.directorio.entidades.*;

public class TestActivos {

    public static void main(String[] args) {
        // Crear un contacto que SÍ tenga WhatsApp
        Telefono telef = new Telefono("movi", "0991234567", 50);
        
        // Primero activar WhatsApp (ya que la operadora es "movi")
        AdminTelefono adminTelefono = new AdminTelefono();
        adminTelefono.activarMensajeria(telef);
        
        Contacto contacto = new Contacto("Carlos", "Mendoza", telef, 70.5);
        
        System.out.println("=== ESTADO INICIAL DEL CONTACTO ===");
        System.out.println("Nombre: " + contacto.getNombre());
        System.out.println("Apellido: " + contacto.getApellido());
        System.out.println("Operadora: " + contacto.getTelefono().getOperadora());
        System.out.println("Número: " + contacto.getTelefono().getNumero());
        System.out.println("Tiene WhatsApp: " + contacto.getTelefono().isTieneWhatsapp());
        System.out.println("Activo: " + contacto.isActivo());
        
        // Invocar el método activarUsuario
        AdminContactos adminContactos = new AdminContactos();
        adminContactos.activarUsuario(contacto);
        
        System.out.println("=== ESTADO DESPUÉS DE ACTIVAR USUARIO ===");
        System.out.println("Nombre: " + contacto.getNombre());
        System.out.println("Apellido: " + contacto.getApellido());
        System.out.println("Operadora: " + contacto.getTelefono().getOperadora());
        System.out.println("Número: " + contacto.getTelefono().getNumero());
        System.out.println("Tiene WhatsApp: " + contacto.getTelefono().isTieneWhatsapp());
        System.out.println("Activo: " + contacto.isActivo());
        
        // Verificación del comportamiento
        System.out.println("=== VERIFICACIÓN DEL COMPORTAMIENTO ===");
        if (contacto.isActivo()) {
            System.out.println("✓ COMPORTAMIENTO CORRECTO: El contacto SÍ se activó porque tiene WhatsApp");
        } else {
            System.out.println("✗ COMPORTAMIENTO INCORRECTO: El contacto NO se activó a pesar de tener WhatsApp");
        }
    }
}