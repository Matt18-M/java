package krakedev.entidades;

import java.util.ArrayList;

public class Estudiante {
    private String cedula;
    private String nombre;
    private String apellido;
    private ArrayList<Nota> notas;

    public Estudiante(String cedula, String nombre, String apellido) {
        this.cedula = cedula;
        this.nombre = nombre;
        this.apellido = apellido;
        this.notas = new ArrayList<>();
    }

    // Getters y Setters
    public String getCedula() {
        return cedula;
    }

    public void setCedula(String cedula) {
        this.cedula = cedula;
    }

    public String getNombre() {
        return nombre;
    }

    public void setNombre(String nombre) {
        this.nombre = nombre;
    }

    public String getApellido() {
        return apellido;
    }

    public void setApellido(String apellido) {
        this.apellido = apellido;
    }

    public ArrayList<Nota> getNotas() {
        return notas;
    }

    public void setNotas(ArrayList<Nota> notas) {
        this.notas = notas;
    }

    public void agregarNota(Nota nuevaNota) {
        // Validar que la calificación esté entre 0 y 10
        if (nuevaNota.getCalificacion() < 0 || nuevaNota.getCalificacion() > 10) {
            System.out.println("Error: La calificación debe estar entre 0 y 10");
            return;
        }
        
        // Validar que no exista una nota con el mismo código de materia
        String codigoMateriaNueva = nuevaNota.getMateria().getCodigo();
        for (Nota notaExistente : notas) {
            if (notaExistente.getMateria().getCodigo().equals(codigoMateriaNueva)) {
                System.out.println("Error: Ya existe una nota para la materia con código: " + codigoMateriaNueva);
                return;
            }
        }
        
        // Si pasa todas las validaciones, agregar la nota
        this.notas.add(nuevaNota);
    }

    public void modificarNota(String codigoMateria, double nuevaCalificacion) {
        // Validar que la nueva calificación esté entre 0 y 10
        if (nuevaCalificacion < 0 || nuevaCalificacion > 10) {
            System.out.println("Error: La calificación debe estar entre 0 y 10");
            return;
        }
        
        // Buscar la nota por código de materia
        boolean encontrado = false;
        for (Nota nota : notas) {
            if (nota.getMateria().getCodigo().equals(codigoMateria)) {
                nota.setCalificacion(nuevaCalificacion);
                encontrado = true;
                break;
            }
        }
        
        // Si no se encontró la materia
        if (!encontrado) {
            System.out.println("Error: No se encontró ninguna materia con el código: " + codigoMateria);
        }
    }

    public double calcularPromedioNotasEstudiante() {
        if (notas.isEmpty()) {
            return 0.0;
        }
        
        double suma = 0;
        for (Nota nota : notas) {
            suma += nota.getCalificacion();
        }
        return suma / notas.size();
    }

    public void mostrar() {
        String resultado = "Estudiante [cedula=" + cedula + ", nombre=" + nombre + ", apellido=" + apellido + ", notas=[";
        
        // Iterar manualmente sobre las notas para construir el string
        for (int i = 0; i < notas.size(); i++) {
            if (i > 0) {
                resultado += ", ";
            }
            Nota nota = notas.get(i);
            resultado += "Nota [materia=" + nota.getMateria() + ", calificacion=" + nota.getCalificacion() + "]";
        }
        
        resultado += "]]";
        System.out.println(resultado);
    }

}